# ============================================================
# Trace · 同迹 — 云函数环境变量模板
# 复制为 .env 并填入真实值；切勿将 .env 提交到 Git
# ============================================================

# ---------- 存储厂商（核心开关） ----------
# 可选：cos | oss | s3 | minio
STORAGE_PROVIDER=cos

# ---------- 用户身份验签（必填） ----------
# MemFire / Supabase 项目的 JWT 密钥（后台 Settings → API 里的 JWT secret）
# 未配置时所有请求直接 401，不会退化成「不验签只解码」
TRACE_JWT_SECRET=

# ---------- 权限校验（必填） ----------
# 云函数用 service role key 校验「当前用户是否属于该 objectKey 前缀对应的情侣空间」
# 未配置时情侣空间归属校验无法执行，请求会以 500 auth_check_failed 拒绝
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 本地开发专用开关（生产必须保持关闭） ----------
# =1 时允许无签名 JWT 与 X-Trace-User-Id 请求头，仅用于本机调试；
# 生产环境开启等于任何人都能冒充任意用户
# TRACE_ALLOW_INSECURE_DEV_AUTH=1

# ---------- 腾讯云 COS ----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-beijing

# ---------- 阿里云 OSS ----------
OSS_ACCESS_KEY=
OSS_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou

# ---------- AWS S3 / MinIO ----------
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_BUCKET=
S3_REGION=ap-southeast-1
# MinIO 本地部署时置为 true
S3_FORCE_PATH_STYLE=false
