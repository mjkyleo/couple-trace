# ============================================================
# Trace · 同迹 — 云函数环境变量模板
# 复制为 .env 并填入真实值；切勿将 .env 提交到 Git
# ============================================================

# ---------- 存储厂商（核心开关） ----------
# 可选：cos | oss | s3 | minio
STORAGE_PROVIDER=cos

# ---------- 权限校验（可选，推荐开启） ----------
# 配置后，云函数会校验「当前用户是否属于该 objectKey 前缀对应的情侣空间」
# 未配置时跳过校验（仅用于本地开发/最小部署）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- 腾讯云 COS ----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-beijing

# ---------- 阿里云 OSS ----------
OSS_ACCESS_KEY=
OSS_SECRET=
OSS_BUCKET=
OSS_REGION=oss-cn-hangzhou

# ---------- AWS S3 / MinIO ----------
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
S3_BUCKET=
S3_REGION=ap-southeast-1
# MinIO 本地部署时置为 true
S3_FORCE_PATH_STYLE=false
